{
  "name": "organize-compre",
  "description": "O app de lista de compras mais prático do mundo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k -n api,web \"node --watch server/index.js\" \"node ./node_modules/vite/bin/vite.js --port=5173 --host=127.0.0.1\"",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node server/index.js",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', {recursive:true, force:true}))\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "latest"
  }
}